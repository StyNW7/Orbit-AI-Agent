{
  "name": "orbit",
  "private": true,
  "version": "1.0.0",
  "description": "Orbit — Smart Career & Learning Ecosystem for future-ready students. INVOFEST 2026 Web Design · SDG 4: Smart Education & Campus Innovation.",
  "packageManager": "pnpm@9.3.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @orbit/web dev",
