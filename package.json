    "lint": "pnpm --filter @orbit/web lint",
    "typecheck": "pnpm --filter @orbit/web typecheck"
  },
  "devDependencies": {
    "typescript": "~5.7.3"
  },
  "pnpm": {
    "overrides": {
      "react-is": "^19.0.0"
    }
  }
}
